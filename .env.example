# Names only — never put real values in this file. Real values go in
# `.env.local` (git-ignored) and in Vercel's project settings.
# Full descriptions: docs/prd/04-architecture-database.md, "Environment variables".

# --- Database (Neon Postgres + pgvector) ---
# DATABASE_URL: pooled connection string, used by the running app.
# DATABASE_URL_UNPOOLED: direct (unpooled) connection string, used by
#   Drizzle Kit for migrations (not in the original PRD list; added here
#   because the Neon integration already names it this way).
# DATABASE_URL_TEST: the separate test database on your personal Neon
#   branch; integration tests reset it before each run.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_URL_TEST=

# --- Private Blob storage ---
BLOB_READ_WRITE_TOKEN=

# --- QStash background jobs ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: only needed to pin a specific Upstash region.
QSTASH_URL=

# --- AI (Google Gemini via the Vercel AI SDK) ---
GOOGLE_GENERATIVE_AI_API_KEY=
# Model names, so models can change without a code change. Pick currently
# available IDs for your Google AI Studio project; verify with
# `pnpm run check:connections`.
AI_MODEL_GENERATE=
AI_MODEL_CHECK=
AI_MODEL_EMBED=
# "gemini" or "fake" (fake is for tests and the load test).
AI_PROVIDER=gemini

# --- Not yet validated by this codebase; added by their owning task ---
# Better Auth (T-01b)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Daily clean-up cron route
CRON_SECRET=
# Where QStash sends job steps; on previews this comes from VERCEL_BRANCH_URL
APP_URL=
# Lets QStash reach protected preview deployments
VERCEL_AUTOMATION_BYPASS_SECRET=
